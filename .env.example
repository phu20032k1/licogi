# Bắt buộc: PostgreSQL/Neon/Supabase/Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# URL public thật của hệ thống, dùng cho canonical URL / sitemap / OpenGraph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bản đồ Mapbox (khuyến nghị cho production).
# Dùng PUBLIC token bắt đầu bằng pk. Không dùng secret token sk. trong NEXT_PUBLIC_*.
# Khi NEXT_PUBLIC_MAPBOX_TOKEN có giá trị, hệ thống tự ưu tiên Mapbox cho các bản đồ public.
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_STYLE="mapbox/streets-v12"

# Fallback khi chưa cấu hình Mapbox hoặc khi muốn dùng tile server khác.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Tài khoản seed cũ.
PRISMA_SEED_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"

# -----------------------------------------------------------------------------
# TÀI KHOẢN ĐIỀU HÀNH THEO SƠ ĐỒ TỔ CHỨC LICOGI 18.3
# -----------------------------------------------------------------------------
# Hệ thống có thể tự tạo các tài khoản này ở lần đăng nhập đầu tiên nếu database
# đã có Organization LICOGI183 và các Role nền tảng. Đặt false sau khi nghiệm thu
# nếu không muốn cho phép cơ chế tự provision tài khoản demo/kiểm thử.
LICOGI_ROLE_ACCOUNTS_ENABLED="true"

# HĐQT / Ban kiểm soát / Ban Tổng Giám đốc
LICOGI_ROLE_PASSWORD_CHAIRMAN="L183.Chairman@2026!"
LICOGI_ROLE_PASSWORD_CONTROL_BOARD="L183.Control@2026!"
