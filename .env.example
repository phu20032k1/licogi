# Bắt buộc: PostgreSQL/Neon/Supabase/Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# URL public thật của hệ thống, dùng cho canonical URL / sitemap / OpenGraph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bản đồ. Có thể thay tile server khi triển khai production để có SLA/usage policy phù hợp.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Giữ tài khoản demo tiện truy cập; nên đổi mật khẩu seed khi đưa dữ liệu thật lên môi trường public.
PRISMA_SEED_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"

# Bắt buộc nếu sử dụng chức năng upload trên Vercel / production
S3_ENDPOINT="https://your-s3-compatible-endpoint"
S3_REGION="us-east-1"
S3_BUCKET="licogi-os"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="https://your-public-file-domain"
MAX_UPLOAD_BYTES="50000000"

# Tùy chọn
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
AUTODESK_CLIENT_ID=""
AUTODESK_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
